rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function chatDoc(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)); }
    function isMember(chatId) {
      return signedIn() && request.auth.uid in chatDoc(chatId).data.memberIds;
    }
    function role(chatId) {
      return chatDoc(chatId).data.roles[request.auth.uid];
    }
    function isAdmin(chatId) {
      return isMember(chatId) && role(chatId) in ['owner', 'admin'];
    }
    function isSystemMessage(data) { return data.type == 'system'; }
    function validMessageType(type) {
      return type in ['text', 'photo', 'video', 'voice', 'file', 'sticker', 'call', 'ice', 'e2e'];
    }
    function validCreate(chatId) {
      return isMember(chatId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.chatId == chatId
        && validMessageType(request.resource.data.type)
        && request.resource.data.idempotencyKey is string
        && request.resource.data.idempotencyKey.size() <= 180
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'chatId', 'type', 'text', 'caption',
          'mediaUrl', 'thumbnailUrl', 'fileName', 'fileSize', 'mimeType',
          'durationMs', 'width', 'height', 'stickerId', 'replyTo',
          'forwardedFrom', 'encryptionEnvelope', 'encrypted', 'decrypted',
          'selfDestructAt', 'noForward', 'idempotencyKey', 'createdAt', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'handle', 'avatarUrl', 'bio', 'lastSeenAt', 'settings', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isMember(chatId);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.roles[request.auth.uid] == 'owner';
      allow update: if isAdmin(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'avatarUrl', 'description', 'memberIds', 'roles', 'permissions',
          'pinnedMessageId', 'pinOperationId', 'updatedAt', 'mutedBy', 'joinPolicy'
        ]);
      allow delete: if signedIn() && role(chatId) == 'owner';

      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if validCreate(chatId);
        allow update: if isMember(chatId)
          && !isSystemMessage(resource.data)
          && (
            (resource.data.authorId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'caption', 'updatedAt']))
            || (isAdmin(chatId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderation', 'updatedAt']))
          );
        allow delete: if isMember(chatId)
          && !isSystemMessage(resource.data)
          && (resource.data.authorId == request.auth.uid || isAdmin(chatId));
      }

      match /operations/{operationId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.operationId == operationId;
        allow update, delete: if false;
      }
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (resource.data.createdBy == request.auth.uid || request.auth.uid in resource.data.recipientIds);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.recipientIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
